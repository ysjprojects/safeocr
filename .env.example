# Public origin of the deployed app; used for the canonical link. Optional.
NEXT_PUBLIC_SITE_URL=https://safeocr.example.com

# Where model files are downloaded from; huggingface.co by default. A self-hosted mirror must be
# laid out like the Hub (`<host>/<repo>/resolve/main/<file>`) and send CORS headers.
# NEXT_PUBLIC_SAFEOCR_MODEL_HOST=https://models.example.com/
