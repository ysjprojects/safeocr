{
  "name": "safeocr",
  "version": "1.0.0",
  "private": true,
  "description": "Private, in-browser OCR for images and PDFs: GLM-OCR on WebGPU (Markdown, HTML tables, LaTeX) with a PP-OCRv5 WebAssembly fallback. Nothing is uploaded.",
  "scripts": {
    "dev": "yarn ocr:sync && next dev",
    "build": "yarn ocr:sync && next build",
    "start": "next start",
    "compile": "tsc --noEmit",
    "lint": "prettier --write './src/**/*.{ts,tsx,scss}' './scripts/**/*.mjs' && eslint './src/**/*.{ts,tsx}' --fix --max-warnings=0",
    "ocr:sync": "node scripts/sync-ocr-runtime.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "katex": "^0.16.22",
    "next": "14",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "paddleocr": "^1.2.0",
    "pdfjs-dist": "^5",
    "react": "18",
    "react-dom": "18",
    "react-markdown": "^10",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7",
    "rehype-sanitize": "^6",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "14",
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/typography": "^0.5.2",
    "@types/node": "^17.0.21",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "@webgpu/types": "^0.1.74",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.10.0",
    "eslint-config-next": "14",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.29.3",
    "eslint-plugin-react-hooks": "^4.3.0",
    "eslint-plugin-react-memo": "^0.0.3",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "postcss": "^8.4.8",
    "prettier": "^2.5.1",
    "prettier-plugin-tailwindcss": "^0.1.8",
    "sass": "^1.49.9",
    "tailwindcss": "^3.4.0",
    "typescript": "5.5"
  }
}
